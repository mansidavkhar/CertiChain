# Copy to .env and fill in. NEVER commit .env, and never put a private key
# here that holds real funds — use a throwaway MetaMask account for testnets.

# Sepolia RPC. Free endpoints: Alchemy, Infura, or https://rpc.sepolia.org
SEPOLIA_RPC_URL=

# Polygon Amoy (cheaper, faster). A public endpoint is used if left blank.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deploying account, WITHOUT the 0x prefix is fine either way.
PRIVATE_KEY=

# Optional, only needed for `npx hardhat verify`.
ETHERSCAN_API_KEY=

# Pinata (IPFS pinning). Create a free key at https://app.pinata.cloud
PINATA_JWT=
