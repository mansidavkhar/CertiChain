# Copy to .env.local (git-ignored).
#
# WARNING: anything prefixed VITE_ is bundled into the JavaScript the browser
# downloads, so this JWT is NOT secret once deployed. For the mini project
# that is fine. In a real deployment, uploads would go through a small backend
# that holds the key server-side. Use a Pinata key scoped to pinJSONToIPFS
# only, and revoke it when you are done.
VITE_PINATA_JWT=

# Your dedicated Pinata gateway, same value as PINATA_GATEWAY in the root .env.
# Without it the dApp falls back to shared public gateways, which frequently
# time out and produce "Could not fetch ... from any gateway".
VITE_PINATA_GATEWAY=

# Optional: force a specific RPC endpoint for reading the blockchain.
# The app ships with several public fallbacks and races them, but some
# networks/ISPs block them all. Setting this (your own Alchemy/Infura URL, or
# whatever you put in AMOY_RPC_URL in the root .env) makes it deterministic.
VITE_RPC_URL=
