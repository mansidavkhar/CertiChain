{
  "name": "certchain",
  "version": "0.1.0",
  "description": "Blockchain + IPFS academic certificate verification (implementation of Sultana et al., Information 2023)",
  "scripts": {
    "postinstall": "node scripts/setup-solc-offline.js || true",
    "setup:solc": "node scripts/setup-solc-offline.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:lib": "node --test \"test-lib/*.test.mjs\"",
    "test:all": "npm run test && npm run test:lib",
    "gas": "cross-env REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "doctor": "node scripts/doctor.mjs",
    "bench:cipher": "node scripts/bench-cipher.mjs",
    "bench:chain": "hardhat run scripts/bench-chain.mjs",
    "bench:chain:amoy": "hardhat run scripts/bench-chain.mjs --network amoy",
    "charts": "node scripts/make-charts.mjs",
    "evaluate": "npm run bench:cipher && npm run bench:chain && npm run charts"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "hardhat": "^2.29.1",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "qrcode": "^1.5.4"
  }
}
